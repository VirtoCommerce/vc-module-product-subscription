<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test-support library, not a test project: connector repositories reference it and derive their own test class
    from StoredCredentialConnectorContractTests. See README.md in this folder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <Description>Contract tests for Virto Commerce payment connectors that implement the stored credential (card on file) flow.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NU5104: depends on the prerelease Payment module package until the stored credential contract is released. -->
    <NoWarn>1591;NU1608;NU1603;NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="VirtoCommerce.PaymentModule.Core" Version="3.1011.0-alpha.325-vcst-6507" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
