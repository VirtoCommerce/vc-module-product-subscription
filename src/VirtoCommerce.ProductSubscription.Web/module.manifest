<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.ProductSubscription</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1089.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Core" version="3.1012.0" />
    <dependency id="VirtoCommerce.Store" version="3.1010.0" />
    <dependency id="VirtoCommerce.Customer" version="3.1030.0" />
    <dependency id="VirtoCommerce.Catalog" version="3.1050.0" />
    <dependency id="VirtoCommerce.Cart" version="3.1012.0" />
    <dependency id="VirtoCommerce.Orders" version="3.1018.0" />
    <dependency id="VirtoCommerce.Payment" version="3.1011.0-alpha.325-vcst-6507" />
    <dependency id="VirtoCommerce.Marketing" version="3.1009.0" />
    <dependency id="VirtoCommerce.Notifications" version="3.1018.0" />
    <dependency id="VirtoCommerce.BackgroundJobs" version="3.1054.0" />
    <dependency id="VirtoCommerce.Xapi" version="3.1027.0" />
    <dependency id="VirtoCommerce.XCatalog" version="3.1023.0" />
    <dependency id="VirtoCommerce.XCart" version="3.1043.0-alpha.300-vcst-6507" />
  </dependencies>

  <title>Product Subscriptions (Subscribe &amp; Save)</title>
  <description>Item-level product subscriptions for physical goods: plans with frequencies and discounts, renewals priced through xCart, automatic charging of saved cards, reminders and US auto-renewal compliance, customer self-service through xAPI.</description>

  <authors>
    <author>Oleg Zhuk</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-product-subscription</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.ProductSubscription)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.ProductSubscription.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.ProductSubscription.Web.Module, VirtoCommerce.ProductSubscription.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>subscription subscribe-and-save recurring orders</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
