<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed holds VirtoCommerce.PaymentModule.Core 3.1012.0-alpha.6507, which adds the stored credential
    contract (ISupportStoredCredentialFlow). Remove this source once the Payment module release is published to nuget.org.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="virto-local" value="../.local-nuget" />
  </packageSources>
</configuration>
